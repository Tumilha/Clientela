generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Produto {
  IdProduto   Int      @id @default(autoincrement())
  Codigo      String   @unique @db.VarChar(45)
  NomeProduto String   @db.VarChar(45)
  Preco       Float
  Quantidade  Int

  ItensVenda ItemVenda[]
}

model Venda {
  NotaFiscal Int      @id @default(autoincrement())
  Data       DateTime
  ValorTotal Float

  CpfCliente     String @db.VarChar(11)
  CpfFuncionario String @db.VarChar(11)

  Cliente     Cliente     @relation(fields: [CpfCliente], references: [CpfCliente])
  Funcionario Funcionario @relation(fields: [CpfFuncionario], references: [CpfFunc])

  ItensVenda ItemVenda[]
}

model Funcionario {
  CpfFunc  String @id @db.VarChar(11)
  NomeFunc String @db.VarChar(45)
  Cargo    String @db.VarChar(45)
  Salario  Float

  Vendas Venda[]
}

model ItemVenda {
  IdItem     Int @id @default(autoincrement())
  Quantidade Int
  Preco      Float

  NotaFiscal Int
  IdProduto  Int

  Venda   Venda   @relation(fields: [NotaFiscal], references: [NotaFiscal])
  Produto Produto @relation(fields: [IdProduto], references: [IdProduto])
}